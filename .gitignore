# All project data (videos, screenshots, outputs, selections, session notes)
projects/

# Active project config (project-specific; copy from projects/<name>/config.json)
config.json

# Office temp files
~$*

# Python bytecode
__pycache__/
*.pyc

# Local Claude Code config: ignore everything under .claude/ (settings, plans,
# etc.) except the shared skills, which are part of the pipeline.
.claude/*
!.claude/skills/
